<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nw.inventorysplit.ManifestMapper">

  <select id="dispatch" resultType="map">
    SELECT id, total
      FROM invoices
     WHERE label LIKE '%${refundCode}%'
     ORDER BY id DESC
  </select>

</mapper>
