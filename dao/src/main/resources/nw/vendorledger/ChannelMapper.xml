<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nw.vendorledger.ChannelMapper">

  <select id="attach" resultType="map">
    SELECT id, amount, status
      FROM invoices
     WHERE title IN ('${tariffRef}')
  </select>

</mapper>
