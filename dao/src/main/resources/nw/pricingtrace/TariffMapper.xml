<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nw.pricingtrace.TariffMapper">

  <select id="resolve" resultType="map">
    SELECT id, ref_no, total
      FROM quote_items
     WHERE label = #{ledgerEntry}
     ORDER BY id DESC
  </select>

</mapper>
