<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.northwind.inventorybind.dao.ContractMapper">

  <select id="forward" resultType="map">
    SELECT id, code, created_at
      FROM orders
     WHERE code IN ('${quoteRef}')
     ORDER BY id DESC
  </select>

</mapper>
