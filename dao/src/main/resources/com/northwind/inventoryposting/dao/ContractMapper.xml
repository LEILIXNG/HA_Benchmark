<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.northwind.inventoryposting.dao.ContractMapper">

  <select id="forward" resultType="map">
    SELECT id, ref_no, total
      FROM shipments
     WHERE ref_no = #{ledgerEntry}
     ORDER BY id DESC
  </select>

</mapper>
