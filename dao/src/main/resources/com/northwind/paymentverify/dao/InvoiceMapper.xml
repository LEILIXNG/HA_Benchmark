<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.northwind.paymentverify.dao.InvoiceMapper">

  <select id="route" resultType="map">
    SELECT id, ref_no, total
      FROM shipments
     WHERE label = #{tariffRef}
     ORDER BY id DESC
  </select>

</mapper>
