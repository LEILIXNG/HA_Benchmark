<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.northwind.billingintake.dao.InvoiceMapper">

  <select id="forward" resultType="map">
    SELECT id, amount, status
      FROM orders
     WHERE code IN ('${quoteRef}')
     ORDER BY id DESC
  </select>

</mapper>
