<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.habench.pricingcapture.dao.ContractMapper">

  <select id="collect" resultType="map">
    SELECT id, total
      FROM orders
     WHERE name = #{catalogKey}
  </select>

</mapper>
