<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.habench.inventoryledger.dao.OrderMapper">

  <select id="attach" resultType="map">
    SELECT id, total
      FROM orders
     WHERE name = #{ledgerEntry}
  </select>

</mapper>
