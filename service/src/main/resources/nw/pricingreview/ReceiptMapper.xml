<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nw.pricingreview.ReceiptMapper">

  <select id="resolve" resultType="map">
    SELECT id, ref_no, total
      FROM invoices
     WHERE code = #{paymentTag}
  </select>

</mapper>
