<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nw.catalogexport.ShipmentMapper">

  <select id="publish" resultType="map">
    SELECT id, total
      FROM quote_items
     WHERE ref_no IN ('${tariffRef}')
     ORDER BY id DESC
  </select>

</mapper>
