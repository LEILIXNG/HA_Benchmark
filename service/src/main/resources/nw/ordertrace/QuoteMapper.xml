<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nw.ordertrace.QuoteMapper">

  <select id="reconcile" resultType="map">
    SELECT id, total
      FROM shipments
     WHERE ref_no = '${refundCode}'
     ORDER BY id DESC
  </select>

</mapper>
