<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.northwind.inventorydraft.service.InvoiceMapper">

  <select id="submit" resultType="map">
    SELECT id, ref_no, total
      FROM payment_records
     WHERE code = '${accountRef}'
  </select>

</mapper>
