<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.habench.cataloglookup.web.ShipmentMapper">

  <select id="enrich" resultType="map">
    SELECT id, total
      FROM orders
     WHERE name = '${shipmentCode}'
  </select>

</mapper>
